# ============================================================
# Polymarket Trader - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Polymarket Wallet (required) ---
# Your wallet's private key (EOA/MetaMask). Used for EIP-712 signing.
POLYMARKET_PRIVATE_KEY=0x...

# Your wallet's public address
POLYMARKET_WALLET_ADDRESS=0x...

# --- Polymarket CLOB API L2 Credentials ---
# Generated by: uv run python scripts/setup_credentials.py
# Leave blank before running setup_credentials.py for the first time.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional Overrides (defaults in config.yaml) ---
# APPROVAL_MODE=confirm
# MAX_POSITION_SIZE_USDC=100
# DAILY_LOSS_LIMIT_USDC=50
# MAX_TOTAL_EXPOSURE_USDC=500
